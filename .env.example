# Binance Spot API credentials — store in Vercel Environment Variables, never in Git
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading parameters
SYMBOL=BTC/USDT
TARGET_ORDER_USD=5.5
MAX_POSITIONS=2
TAKE_PROFIT_PCT=2.0
STOP_LOSS_PCT=1.0
LOOP_INTERVAL_SEC=10
BUY_COOLDOWN_SEC=180
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=1.0
TRAILING_CALLBACK_PCT=0.35
MAX_HOLD_TIME_SEC=7200
STAGNANT_EXIT_PCT=0.15
MAX_SPREAD_PCT=0.15
MIN_VOLATILITY_PCT=0.15

# Optional AI key
# GEMINI_API_KEY=your_key_here
