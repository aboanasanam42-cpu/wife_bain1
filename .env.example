# Binance Spot API credentials — store in Vercel Environment Variables, never in Git
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
TRADE_TRIGGER_TOKEN=generate-a-long-random-token
# Vercel Cron uses this secret as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-different-long-random-token
LIVE_TRADING=false

# Trading parameters
SYMBOL=BTC/USDT
TARGET_ORDER_USD=5.5
MAX_POSITIONS=1
BUY_COOLDOWN_SEC=30

# Buy only after a real dip followed by a rebound confirmation
BUY_DIP_MIN_PCT=0.25
BUY_REBOUND_CONFIRM_PCT=0.08
BUY_RSI_MAX=48
MIN_VOLATILITY_PCT=0.20
MAX_SPREAD_PCT=0.15

# Optional proxy for restricted regions (e.g. if server is located in USA)
# BINANCE_PROXY=http://user:pass@proxy-ip:port

# High-water trailing exit + emergency capital-release exit
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=0.15
TRAILING_CALLBACK_PCT=0.20
STOP_LOSS_PCT=0.40
MAX_HOLD_TIME_SEC=1200
STAGNANT_EXIT_PCT=0.00

# TAKE_PROFIT_PCT is intentionally not used by the new strategy:
# profits are allowed to run until the trailing reversal is detected.
